<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="rasentra_kitchen.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <t t-if="pos.rasentraKitchenEnabled">
                <button class="btn btn-secondary btn-lg py-5 o_rasentra_course" t-on-click="() => this.pos.rasentraSetCourse()">
                    <i class="fa fa-list-ol me-1"/> Course baris
                </button>
                <button class="btn btn-secondary btn-lg py-5 o_rasentra_send_course" t-on-click="() => this.pos.rasentraSendCourse()">
                    <i class="fa fa-paper-plane me-1"/> Kirim satu course
                </button>
            </t>
        </xpath>
    </t>
</templates>
