<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_kitchen_board" model="ir.actions.client">
        <field name="name">Rasentra Kitchen</field>
        <field name="tag">rasentra_kitchen.board</field>
    </record>
    <record id="view_kitchen_ticket_list" model="ir.ui.view">
        <field name="name">rasentra.kitchen.ticket.list</field>
        <field name="model">rasentra.kitchen.ticket</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/><field name="outlet_id"/><field name="label"/><field name="station"/>
                <field name="sequence"/><field name="bump_code"/><field name="channel"/><field name="course"/>
            </list>
        </field>
    </record>
    <record id="view_kitchen_ticket_form" model="ir.ui.view">
        <field name="name">rasentra.kitchen.ticket.form</field>
        <field name="model">rasentra.kitchen.ticket</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group><field name="label"/><field name="station"/><field name="bump_code"/><field name="sequence"/></group>
                        <group><field name="outlet_id"/><field name="pos_order_id"/><field name="channel"/><field name="course"/></group>
                    </group>
                    <field name="item_ids">
                        <list>
                            <field name="product_id"/><field name="quantity"/><field name="status" widget="badge"/>
                            <field name="started_at"/><field name="ready_at"/><field name="served_at"/>
                            <field name="recipe_version_id"/><field name="cancel_reason"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_kitchen_item_pivot" model="ir.ui.view">
        <field name="name">rasentra.kitchen.item.pivot</field>
        <field name="model">rasentra.kitchen.item</field>
        <field name="arch" type="xml">
            <pivot string="Item dapur">
                <field name="station" type="row"/>
                <field name="status" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_consumption_list" model="ir.ui.view">
        <field name="name">rasentra.consumption.event.list</field>
        <field name="model">rasentra.consumption.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="occurred_at"/><field name="outlet_id"/><field name="product_id"/><field name="quantity" sum="Total"/>
                <field name="uom_id"/><field name="reason"/><field name="recipe_version_id"/><field name="source_ref"/>
            </list>
        </field>
    </record>
    <record id="action_kitchen_ticket" model="ir.actions.act_window">
        <field name="name">Tiket dapur</field>
        <field name="res_model">rasentra.kitchen.ticket</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_kitchen_item" model="ir.actions.act_window">
        <field name="name">Item dapur</field>
        <field name="res_model">rasentra.kitchen.item</field>
        <field name="view_mode">pivot</field>
    </record>
    <record id="action_consumption" model="ir.actions.act_window">
        <field name="name">Konsumsi bahan</field>
        <field name="res_model">rasentra.consumption.event</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_kitchen_board" name="Layar dapur (KDS)" action="action_kitchen_board"
              parent="rasentra_recipe.menu_rasentra_kitchen_master" sequence="10"/>
    <menuitem id="menu_kitchen_ticket" action="action_kitchen_ticket" parent="rasentra_recipe.menu_rasentra_kitchen_master" sequence="20"/>
    <menuitem id="menu_kitchen_item" action="action_kitchen_item" parent="rasentra_recipe.menu_rasentra_kitchen_master" sequence="25"/>
    <menuitem id="menu_consumption" action="action_consumption" parent="rasentra_recipe.menu_rasentra_kitchen_master" sequence="70"/>
</odoo>
