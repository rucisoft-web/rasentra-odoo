<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_kitchen" model="ir.ui.view">
        <field name="name">pos.order.form.rasentra.kitchen</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Dapur" name="rasentra_kitchen" invisible="not rasentra_kitchen_ticket_ids">
                    <field name="rasentra_queue_no" readonly="1"/>
                    <field name="rasentra_kitchen_ticket_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_product_attribute_value_kitchen" model="ir.ui.view">
        <field name="name">product.attribute.rasentra.modifier</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="after">
                <field name="rasentra_modifier_key" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
