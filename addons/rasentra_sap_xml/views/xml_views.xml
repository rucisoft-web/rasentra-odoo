<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xml_batch_list" model="ir.ui.view">
        <field name="name">rasentra.xml.batch.list</field>
        <field name="model">rasentra.xml.batch</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="status == 'rejected'">
                <field name="create_date" string="Diterima"/>
                <field name="kind"/>
                <field name="file_name"/>
                <field name="document_count"/>
                <field name="duplicate_count"/>
                <field name="status" widget="badge" decoration-success="status == 'staged'" decoration-danger="status == 'rejected'"/>
                <field name="imported_by_id"/>
            </list>
        </field>
    </record>
    <record id="view_xml_batch_form" model="ir.ui.view">
        <field name="name">rasentra.xml.batch.form</field>
        <field name="model">rasentra.xml.batch</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header><field name="status" widget="statusbar"/></header>
                <sheet>
                    <h1><field name="file_name"/></h1>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="document_count"/>
                            <field name="duplicate_count"/>
                        </group>
                        <group>
                            <field name="sha256"/>
                            <field name="attachment_id"/>
                            <field name="imported_by_id"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert" invisible="status != 'rejected'">
                        <field name="error_code"/>: <field name="error_message"/>
                    </div>
                    <field name="summary_text" nolabel="1" invisible="status != 'staged'"/>
                    <notebook>
                        <page string="Dokumen">
                            <field name="document_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_xml_document_list" model="ir.ui.view">
        <field name="name">rasentra.xml.document.list</field>
        <field name="model">rasentra.xml.document</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="has_difference" decoration-muted="status == 'waiting_dependency'">
                <field name="business_date"/>
                <field name="branch_code"/>
                <field name="doc_type"/>
                <field name="source_no"/>
                <field name="legacy_customer_code"/>
                <field name="document_total_source" string="Total sumber"/>
                <field name="document_total_calculated" string="Total hitung"/>
                <field name="rounding_difference" string="Selisih"/>
                <field name="has_difference" column_invisible="1"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_xml_document_form" model="ir.ui.view">
        <field name="name">rasentra.xml.document.form</field>
        <field name="model">rasentra.xml.document</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header><field name="status" widget="statusbar"/></header>
                <sheet>
                    <h1><field name="source_no"/></h1>
                    <group>
                        <group>
                            <field name="doc_type"/>
                            <field name="branch_code"/>
                            <field name="business_date"/>
                            <field name="legacy_customer_code"/>
                            <field name="legacy_warehouse_code"/>
                        </group>
                        <group>
                            <field name="document_total_source"/>
                            <field name="document_total_calculated"/>
                            <field name="rounding_difference"/>
                            <field name="batch_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="source_line_key"/>
                            <field name="legacy_item_code"/>
                            <field name="quantity"/>
                            <field name="uom"/>
                            <field name="unit_price"/>
                            <field name="line_discount_pct"/>
                            <field name="ref_invoice_no"/>
                            <field name="amount"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_xml_document_search" model="ir.ui.view">
        <field name="name">rasentra.xml.document.search</field>
        <field name="model">rasentra.xml.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_no"/>
                <field name="branch_code"/>
                <filter name="difference" string="Ada selisih" domain="[('has_difference', '=', True)]"/>
                <filter name="waiting" string="Menunggu invoice" domain="[('status', '=', 'waiting_dependency')]"/>
                <group expand="0" string="Kelompok">
                    <filter name="by_type" string="Jenis" context="{'group_by': 'doc_type'}"/>
                    <filter name="by_branch" string="Cabang" context="{'group_by': 'branch_code'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_outlet_form_posting_channel" model="ir.ui.view">
        <field name="name">rasentra.outlet.form.sap.channel</field>
        <field name="model">rasentra.outlet</field>
        <field name="inherit_id" ref="rasentra_core.view_outlet_form"/>
        <field name="arch" type="xml">
            <field name="sap_warehouse_code" position="after">
                <field name="sap_posting_channel"/>
            </field>
        </field>
    </record>
    <record id="action_xml_batch" model="ir.actions.act_window">
        <field name="name">Riwayat impor XML</field>
        <field name="res_model">rasentra.xml.batch</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_xml_document" model="ir.actions.act_window">
        <field name="name">Dokumen sumber XML</field>
        <field name="res_model">rasentra.xml.document</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_xml" name="XML NMEXML" parent="rasentra_sap_b1.menu_sap" sequence="40"
              groups="rasentra_core.group_rasentra_finance"/>
    <menuitem id="menu_xml_batch" action="action_xml_batch" parent="menu_xml" sequence="10"/>
    <menuitem id="menu_xml_document" action="action_xml_document" parent="menu_xml" sequence="20"/>
</odoo>
