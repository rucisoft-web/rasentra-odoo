<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Gelombang cut-over -->
    <record id="view_migration_wave_list" model="ir.ui.view">
        <field name="name">rasentra.migration.wave.list</field>
        <field name="model">rasentra.migration.wave</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="legacy"/>
                <field name="company_id"/>
                <field name="outlet_ids" widget="many2many_tags"/>
                <field name="cutover_date"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge" decoration-info="state == 'plan'" decoration-warning="state == 'cutover'"
                       decoration-success="state in ('live', 'closed')"/>
            </list>
        </field>
    </record>

    <record id="view_migration_wave_form" model="ir.ui.view">
        <field name="name">rasentra.migration.wave.form</field>
        <field name="model">rasentra.migration.wave</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="mis. Gelombang 1 – Solo"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="legacy" widget="radio"/>
                            <field name="company_id"/>
                            <field name="outlet_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]"/>
                        </group>
                        <group>
                            <field name="cutover_date"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Langkah" name="steps">
                            <field name="step_ids">
                                <list create="0" delete="0" editable="bottom"
                                      decoration-success="done" decoration-danger="overdue">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="overdue" column_invisible="1"/>
                                    <field name="when" string="Kapan"/>
                                    <field name="due_date" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="instructions" readonly="1"/>
                                    <field name="note"/>
                                    <field name="done" readonly="1"/>
                                    <field name="done_by_id" optional="hide"/>
                                    <field name="done_at" optional="hide"/>
                                    <button name="action_done" type="object" string="Selesai" icon="fa-check"
                                            class="btn-primary" invisible="done"/>
                                    <button name="action_reopen" type="object" string="Buka lagi" icon="fa-undo"
                                            invisible="not done"/>
                                </list>
                            </field>
                        </page>
                        <page string="Impor data" name="batches">
                            <field name="batch_ids" context="{'default_wave_id': id}">
                                <list>
                                    <field name="entity"/>
                                    <field name="file_name"/>
                                    <field name="row_count"/>
                                    <field name="error_count"/>
                                    <field name="imported_count"/>
                                    <field name="state" widget="badge" decoration-danger="state == 'rejected'"
                                           decoration-success="state == 'imported'" decoration-info="state == 'checked'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan" name="note">
                            <field name="note" placeholder="Keputusan, kontak, kendala..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_migration_wave" model="ir.actions.act_window">
        <field name="name">Gelombang cut-over</field>
        <field name="res_model">rasentra.migration.wave</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Buat gelombang migrasi pertama</p>
            <p>Satu gelombang = satu cabang atau kelompok outlet yang pindah ke Rasentra di hari yang sama
                (hari H). Langkah H−45 sampai H+30 dibuat otomatis sesuai sistem lamanya: Raptor + SAP B1
                atau Rene POS + Accurate.</p>
        </field>
    </record>

    <!-- Impor data -->
    <record id="view_migration_batch_list" model="ir.ui.view">
        <field name="name">rasentra.migration.batch.list</field>
        <field name="model">rasentra.migration.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Diunggah"/>
                <field name="wave_id"/>
                <field name="entity"/>
                <field name="file_name"/>
                <field name="row_count"/>
                <field name="error_count"/>
                <field name="imported_count"/>
                <field name="imported_by_id" optional="hide"/>
                <field name="state" widget="badge" decoration-danger="state == 'rejected'"
                       decoration-success="state == 'imported'" decoration-info="state == 'checked'"/>
            </list>
        </field>
    </record>

    <record id="view_migration_batch_form" model="ir.ui.view">
        <field name="name">rasentra.migration.batch.form</field>
        <field name="model">rasentra.migration.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_download_template" type="object" string="Unduh template" icon="fa-download"
                            invisible="not entity"/>
                    <button name="action_check" type="object" string="Periksa" class="btn-secondary"
                            invisible="state == 'imported' or not file"/>
                    <button name="action_import" type="object" string="Impor" class="btn-primary"
                            invisible="state == 'imported' or not file"
                            confirm="Data ditulis ke Rasentra. Lanjutkan?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,checked,imported"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="wave_id"/>
                            <field name="entity" readonly="state == 'imported'"/>
                            <field name="file" filename="file_name" readonly="state == 'imported'"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="row_count"/>
                            <field name="error_count"/>
                            <field name="imported_count" invisible="state != 'imported'"/>
                            <field name="imported_by_id" invisible="state != 'imported'"/>
                            <field name="imported_at" invisible="state != 'imported'"/>
                            <field name="sha256" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not entity_note">
                        <field name="entity_note" nolabel="1"/>
                    </div>
                    <field name="error_html" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_migration_batch" model="ir.actions.act_window">
        <field name="name">Impor data awal</field>
        <field name="res_model">rasentra.migration.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Impor data awal dari file CSV</p>
            <p>Urutan: 1 wilayah, 2 outlet, 3 pegawai, 4 produk, 5 harga, 6 mapping akuntansi, lalu saldo awal
                7 Pack ID, 8 barang retail, 9 bahan dapur. Pilih jenis data, unduh templatenya, isi, unggah,
                tekan Periksa. Data baru ditulis setelah semua baris lolos.</p>
        </field>
    </record>

    <menuitem id="menu_migration_root" name="Migrasi" parent="rasentra_core.menu_rasentra_root" sequence="90"
              groups="rasentra_core.group_rasentra_admin"/>
    <menuitem id="menu_migration_wave" action="action_migration_wave" parent="menu_migration_root" sequence="10"/>
    <menuitem id="menu_migration_batch" action="action_migration_batch" parent="menu_migration_root" sequence="20"/>
</odoo>
