<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="rasentra_cooking_fee.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <t t-if="rasentraCookingEnabled">
                <button class="btn btn-secondary btn-lg py-5 o_rasentra_cook" t-on-click="() => this.pos.rasentraCookSelectedPack()">
                    <i class="fa fa-fire me-1"/> Masak pack ini
                </button>
                <button class="btn btn-secondary btn-lg py-5 o_rasentra_cook_receipt" t-on-click="() => this.pos.rasentraCookFromReceipt()">
                    <i class="fa fa-ticket me-1"/> Masak dari struk retail
                </button>
            </t>
        </xpath>
    </t>
</templates>
