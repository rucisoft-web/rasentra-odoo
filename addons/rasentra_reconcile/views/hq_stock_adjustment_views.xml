<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hq_stock_adjustment_list" model="ir.ui.view">
        <field name="name">rasentra.hq.stock.adjustment.list</field>
        <field name="model">rasentra.hq.stock.adjustment</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="business_date"/>
                <field name="doc_no"/>
                <field name="outlet_id"/>
                <field name="kind"/>
                <field name="reason"/>
            </list>
        </field>
    </record>
    <record id="view_hq_stock_adjustment_form" model="ir.ui.view">
        <field name="name">rasentra.hq.stock.adjustment.form</field>
        <field name="model">rasentra.hq.stock.adjustment</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <h1><field name="doc_no"/></h1>
                    <group>
                        <group><field name="outlet_id"/><field name="kind"/><field name="business_date"/></group>
                        <group><field name="reason"/><field name="source_type"/><field name="uuid"/></group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="line_no"/><field name="product_code"/><field name="product_id"/>
                            <field name="pack_code"/><field name="quantity"/><field name="uom"/>
                            <field name="from_state"/><field name="to_state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_hq_stock_adjustment_line_pivot" model="ir.ui.view">
        <field name="name">rasentra.hq.stock.adjustment.line.pivot</field>
        <field name="model">rasentra.hq.stock.adjustment.line</field>
        <field name="arch" type="xml">
            <pivot string="Penyesuaian stok">
                <field name="outlet_id" type="row"/>
                <field name="kind" type="col"/>
                <field name="signed_quantity" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_hq_stock_adjustment_line_list" model="ir.ui.view">
        <field name="name">rasentra.hq.stock.adjustment.line.list</field>
        <field name="model">rasentra.hq.stock.adjustment.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="business_date"/><field name="outlet_id"/><field name="kind"/>
                <field name="product_code"/><field name="product_id"/><field name="pack_code"/>
                <field name="signed_quantity" sum="Total"/><field name="uom"/>
            </list>
        </field>
    </record>
    <record id="action_hq_stock_adjustment" model="ir.actions.act_window">
        <field name="name">Penyesuaian stok outlet</field>
        <field name="res_model">rasentra.hq.stock.adjustment</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_hq_stock_adjustment_line" model="ir.actions.act_window">
        <field name="name">Analisis waste &amp; opname</field>
        <field name="res_model">rasentra.hq.stock.adjustment.line</field>
        <field name="view_mode">pivot,list</field>
    </record>
    <menuitem id="menu_hq_stock_adjustment" action="action_hq_stock_adjustment" parent="menu_reports" sequence="40"/>
    <menuitem id="menu_hq_stock_adjustment_line" action="action_hq_stock_adjustment_line" parent="menu_reports" sequence="45"/>
</odoo>
