<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visit_list" model="ir.ui.view">
        <field name="name">rasentra.visit.list</field>
        <field name="model">rasentra.visit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="opened_at"/><field name="outlet_id"/><field name="table_id"/><field name="guest_count"/>
                <field name="waiter_id"/><field name="bill_requested_at"/><field name="closed_at"/><field name="amount_total"/>
                <field name="status" widget="badge" decoration-success="status == 'open'"/>
            </list>
        </field>
    </record>
    <record id="view_visit_form" model="ir.ui.view">
        <field name="name">rasentra.visit.form</field>
        <field name="model">rasentra.visit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header><field name="status" widget="statusbar"/></header>
                <sheet>
                    <group>
                        <group><field name="outlet_id"/><field name="table_id"/><field name="guest_count"/><field name="waiter_id"/></group>
                        <group><field name="opened_at"/><field name="bill_requested_at"/><field name="closed_at"/><field name="visit_token"/></group>
                    </group>
                    <field name="order_ids"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_visit" model="ir.actions.act_window">
        <field name="name">Kunjungan meja</field>
        <field name="res_model">rasentra.visit</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_visit" action="action_visit" parent="rasentra_recipe.menu_rasentra_kitchen_master" sequence="80"/>
</odoo>
