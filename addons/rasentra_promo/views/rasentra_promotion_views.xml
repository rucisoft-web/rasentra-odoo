<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_promotion_version_list" model="ir.ui.view">
        <field name="model">rasentra.promotion.version</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'published'" decoration-muted="state in ('superseded', 'expired')">
                <field name="code"/>
                <field name="name"/>
                <field name="version"/>
                <field name="type"/>
                <field name="scope"/>
                <field name="stacking"/>
                <field name="priority"/>
                <field name="starts_at"/>
                <field name="ends_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_promotion_version_form" model="ir.ui.view">
        <field name="model">rasentra.promotion.version</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_promotion_simulate)d" type="action" string="Simulasi" class="btn-primary"
                            invisible="state not in ('draft', 'simulated')" context="{'default_version_id': id}"/>
                    <button name="%(action_promotion_publish)d" type="action" string="Terbitkan"
                            invisible="state != 'simulated'" context="{'default_version_id': id}"
                            groups="rasentra_core.group_rasentra_merch"/>
                    <button name="action_new_version" type="object" string="Versi baru"
                            invisible="state in ('draft', 'simulated')"/>
                    <button name="%(action_promotion_stop)d" type="action" string="Hentikan"
                            invisible="state != 'published'" context="{'default_version_id': id}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,simulated,published"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="promotion_id" readonly="state not in ('draft', 'simulated')"/>
                            <field name="name"/>
                            <field name="version" readonly="1"/>
                            <field name="type" readonly="state not in ('draft', 'simulated')"/>
                            <field name="scope" readonly="state not in ('draft', 'simulated')"/>
                            <field name="stacking" readonly="state not in ('draft', 'simulated')"/>
                            <field name="priority" readonly="state not in ('draft', 'simulated')"/>
                            <field name="funded_by" readonly="state not in ('draft', 'simulated')"/>
                        </group>
                        <group>
                            <field name="starts_at" readonly="state not in ('draft', 'simulated')"/>
                            <field name="ends_at" readonly="state not in ('draft', 'simulated')"/>
                            <field name="created_by"/>
                            <field name="approved_by"/>
                            <field name="published_at"/>
                            <field name="uuid" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Aturan">
                            <p class="text-muted">
                                Contoh: {"percent": 10, "product_ids": ["SIRLOIN-AUS"]},
                                {"tiers": [{"min_weight": "2", "percent": 5}]},
                                {"buy_product_id": "SOSIS", "buy_qty": 2, "get_product_id": "SOSIS", "get_qty": 1}.
                                Produk disebut dengan kode produk.
                            </p>
                            <field name="rules" widget="ace" options="{'mode': 'json'}"
                                   readonly="state not in ('draft', 'simulated')"/>
                            <label for="channels"/>
                            <field name="channels" widget="ace" options="{'mode': 'json'}"
                                   readonly="state not in ('draft', 'simulated')"/>
                        </page>
                        <page string="Outlet target" invisible="not target_ids">
                            <field name="target_ids">
                                <list>
                                    <field name="outlet_id"/>
                                    <field name="ack_status"/>
                                    <field name="acked_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_promotion_version_search" model="ir.ui.view">
        <field name="model">rasentra.promotion.version</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <filter name="active_promos" string="Draft dan terbit" domain="[('state', 'in', ('draft', 'simulated', 'published'))]"/>
            </search>
        </field>
    </record>

    <record id="action_promotion_version" model="ir.actions.act_window">
        <field name="name">Promo</field>
        <field name="res_model">rasentra.promotion.version</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_promos': 1}</field>
    </record>

    <menuitem id="menu_promotion" action="action_promotion_version" parent="rasentra_core.menu_rasentra_catalog"
              sequence="30"/>
</odoo>
