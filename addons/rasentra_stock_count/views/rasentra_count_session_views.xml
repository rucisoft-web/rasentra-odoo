<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_count_session_list" model="ir.ui.view">
        <field name="name">rasentra.count.session.list</field>
        <field name="model">rasentra.count.session</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="outlet_id"/>
                <field name="count_type"/>
                <field name="blind"/>
                <field name="current_round"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'recount'"/>
            </list>
        </field>
    </record>
    <record id="view_count_session_form" model="ir.ui.view">
        <field name="name">rasentra.count.session.form</field>
        <field name="model">rasentra.count.session</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_review" type="object" string="Review selisih" class="btn-primary"
                            invisible="state not in ('counting', 'recount')" groups="rasentra_core.group_rasentra_outlet_head"/>
                    <button name="action_approve" type="object" string="Setujui &amp; posting" class="btn-primary"
                            invisible="state != 'review'" groups="rasentra_core.group_rasentra_outlet_head"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="outlet_id"/>
                            <field name="count_type"/>
                            <field name="blind"/>
                            <field name="cutoff_at"/>
                        </group>
                        <group>
                            <field name="current_round"/>
                            <field name="recount_threshold"/>
                            <field name="recount_product_ids" widget="many2many_tags"/>
                            <field name="created_by_id"/>
                            <field name="approved_by_id"/>
                            <field name="adjustment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hasil review" invisible="not summary_html" groups="rasentra_core.group_rasentra_outlet_head">
                            <field name="summary_html"/>
                        </page>
                        <page string="Hitungan">
                            <field name="line_ids">
                                <list>
                                    <field name="round"/>
                                    <field name="location_id"/>
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="quantity"/>
                                    <field name="counted_by_id"/>
                                    <field name="counted_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_count_session" model="ir.actions.act_window">
        <field name="name">Sesi opname</field>
        <field name="res_model">rasentra.count.session</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_count_session_new" model="ir.actions.server">
        <field name="name">Buka sesi opname</field>
        <field name="model_id" ref="model_rasentra_count_session"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_new()</field>
    </record>
</odoo>
