<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_layout" inherit_id="web.login_layout" name="Rasentra login">
        <xpath expr="//t[@t-set='body_classname']" position="attributes">
            <attribute name="t-value">'o_rasentra_login'</attribute>
        </xpath>
        <xpath expr="//div[hasclass('container')]/div[1]" position="attributes">
            <attribute name="t-attf-class">card border-0 mx-auto o_rasentra_login_card {{login_card_classes}} o_database_list</attribute>
            <attribute name="style">max-width: 340px;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('card-body')]/div[hasclass('text-center')]" position="inside">
            <div class="o_rasentra_tagline mt-2">Meatshop &amp; restoran · food specialist</div>
        </xpath>
    </template>
</odoo>
