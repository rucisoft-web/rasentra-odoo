<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_outbox_list" model="ir.ui.view">
        <field name="model">rasentra.sync.outbox</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-danger="state == 'parked'" decoration-warning="state == 'failed'"
                  decoration-muted="state == 'acked'">
                <field name="occurred_at"/>
                <field name="event_type"/>
                <field name="entity_type"/>
                <field name="entity_uuid"/>
                <field name="business_date"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="next_attempt_at"/>
                <field name="ack_ref"/>
                <field name="last_error"/>
            </list>
        </field>
    </record>

    <record id="view_outbox_form" model="ir.ui.view">
        <field name="model">rasentra.sync.outbox</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Coba lagi" class="btn-primary"
                            invisible="state not in ('failed', 'parked', 'held')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sending,acked"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_uuid"/>
                            <field name="source_id"/>
                            <field name="outlet_id"/>
                            <field name="event_type"/>
                            <field name="entity_type"/>
                            <field name="entity_uuid"/>
                            <field name="entity_version"/>
                        </group>
                        <group>
                            <field name="occurred_at"/>
                            <field name="business_date"/>
                            <field name="correlation_id"/>
                            <field name="attempts"/>
                            <field name="next_attempt_at"/>
                            <field name="ack_ref"/>
                            <field name="acked_at"/>
                        </group>
                    </group>
                    <field name="last_error" invisible="not last_error"/>
                    <field name="payload" widget="ace" options="{'mode': 'json'}"/>
                    <field name="checksum"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_outbox_search" model="ir.ui.view">
        <field name="model">rasentra.sync.outbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_type"/>
                <field name="entity_uuid"/>
                <filter name="open" string="Belum diterima Central" domain="[('state', '!=', 'acked')]"/>
                <filter name="problem" string="Gagal / parked" domain="[('state', 'in', ('failed', 'parked'))]"/>
            </search>
        </field>
    </record>

    <record id="action_outbox" model="ir.actions.act_window">
        <field name="name">Antrean kirim ke Central</field>
        <field name="res_model">rasentra.sync.outbox</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="action_outbox_retry" model="ir.actions.server">
        <field name="name">Coba lagi</field>
        <field name="model_id" ref="model_rasentra_sync_outbox"/>
        <field name="binding_model_id" ref="model_rasentra_sync_outbox"/>
        <field name="state">code</field>
        <field name="code">records.action_retry()</field>
    </record>

    <record id="view_sync_console_form" model="ir.ui.view">
        <field name="model">rasentra.sync.console</field>
        <field name="arch" type="xml">
            <form string="Sinkron dengan Central">
                <header>
                    <button name="action_dispatch" type="object" string="Kirim sekarang" class="btn-primary"/>
                    <button name="action_pull" type="object" string="Tarik publikasi"/>
                    <button name="action_heartbeat" type="object" string="Uji koneksi"/>
                    <button name="action_bootstrap" type="object" string="Bootstrap dari snapshot"
                            confirm="Terapkan snapshot lengkap dari Central? Data master yang sama akan diperbarui."/>
                </header>
                <sheet>
                    <group>
                        <group string="Koneksi">
                            <field name="central_url"/>
                            <field name="device_code"/>
                            <field name="outlet_code"/>
                            <field name="cursor"/>
                        </group>
                        <group string="Outbox">
                            <field name="outbox_pending"/>
                            <field name="outbox_failed"/>
                            <field name="outbox_parked"/>
                        </group>
                    </group>
                    <group string="Hasil terakhir" invisible="not result">
                        <field name="result" nolabel="1" colspan="2"/>
                    </group>
                    <group>
                        <field name="last_pull"/>
                        <field name="last_heartbeat"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sync_console" model="ir.actions.act_window">
        <field name="name">Sinkron dengan Central</field>
        <field name="res_model">rasentra.sync.console</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

    <menuitem id="menu_sync_lokal" name="Sinkron" parent="rasentra_core.menu_rasentra_root" sequence="75"
              groups="rasentra_core.group_rasentra_admin"/>
    <menuitem id="menu_sync_console" action="action_sync_console" parent="menu_sync_lokal" sequence="10"/>
    <menuitem id="menu_outbox" action="action_outbox" parent="menu_sync_lokal" sequence="20"/>
</odoo>
