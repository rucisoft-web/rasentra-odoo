<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rasentra" model="ir.module.category">
        <field name="name">Rasentra</field>
        <field name="sequence">5</field>
    </record>

    <record id="group_rasentra_user" model="res.groups">
        <field name="name">Pengguna outlet</field>
        <field name="category_id" ref="module_category_rasentra"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rasentra_outlet_head" model="res.groups">
        <field name="name">Kepala outlet</field>
        <field name="category_id" ref="module_category_rasentra"/>
        <field name="implied_ids" eval="[(4, ref('group_rasentra_user'))]"/>
    </record>
    <record id="group_rasentra_merch" model="res.groups">
        <field name="name">Merchandising pusat</field>
        <field name="category_id" ref="module_category_rasentra"/>
        <field name="implied_ids" eval="[(4, ref('group_rasentra_user'))]"/>
    </record>
    <record id="group_rasentra_finance" model="res.groups">
        <field name="name">Finance pusat</field>
        <field name="category_id" ref="module_category_rasentra"/>
        <field name="implied_ids" eval="[(4, ref('group_rasentra_user'))]"/>
    </record>
    <record id="group_rasentra_admin" model="res.groups">
        <field name="name">Admin pusat</field>
        <field name="category_id" ref="module_category_rasentra"/>
        <field name="implied_ids" eval="[(4, ref('group_rasentra_merch')), (4, ref('group_rasentra_finance')), (4, ref('group_rasentra_outlet_head'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_outlet_company" model="ir.rule">
        <field name="name">Outlet: perusahaan yang diizinkan</field>
        <field name="model_id" ref="model_rasentra_outlet"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_device_company" model="ir.rule">
        <field name="name">Perangkat: perusahaan yang diizinkan</field>
        <field name="model_id" ref="model_rasentra_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
