<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_rasentra" model="ir.ui.view">
        <field name="name">product.template.form.rasentra</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="rasentra_type"/>
                <field name="kitchen_station"/>
            </field>
        </field>
    </record>
    <record id="action_rasentra_products" model="ir.actions.act_window">
        <field name="name">Produk</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_rasentra_products" name="Produk" parent="menu_rasentra_catalog" action="action_rasentra_products" sequence="10"/>
</odoo>
